# ============================================================================
# OPEN TRADE - Environment Configuration
# ============================================================================

# Polygon Wallet (Chain A — Polymarket)
PRIVATE_KEY=your_polygon_private_key
PROXY_WALLET_ADDRESS=your_proxy_wallet_address
FUNDER_ADDRESS=your_proxy_wallet_address

# Polymarket API Credentials
POLYMARKET_API_KEY=your_api_key
POLYMARKET_API_SECRET=your_api_secret
POLYMARKET_API_PASSPHRASE=your_api_passphrase

# Kalshi API Credentials (Chain B)
KALSHI_API_KEY_ID=your_kalshi_key_id
KALSHI_PRIVATE_KEY_PATH=kalshi.key
KALSHI_ENABLED=true

# Solana / Phantom (Chain C — Drift Protocol)
SOLANA_WALLET_ADDRESS=3fHba4xfAeeiDCicmww4NJUEAd1cXN4ptEwg2Z8MbYbN
SOLANA_PRIVATE_KEY=your_phantom_private_key
DRIFT_ENV=mainnet-beta
HELIUS_API_KEY=                          # optional — faster RPC

# Telegram Notifications
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Trading Configuration
INITIAL_CAPITAL=1000
SIMULATE_MODE=true

# Polygon RPC
POLYGON_RPC=https://polygon-rpc.com

# Copy Trading Wallets (optional — Chain A)
COPY_WALLET_RN1=
COPY_WALLET_DOMER=
COPY_WALLET_COLDMATH=
