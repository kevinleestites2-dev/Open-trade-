# ============================================================================
# ZEUS PRIME - Environment Configuration
# ============================================================================

# Polygon Wallet (REQUIRED)
PRIVATE_KEY=your_private_key_here
PROXY_WALLET_ADDRESS=your_proxy_wallet_address
FUNDER_ADDRESS=your_proxy_wallet_address

# Polymarket API Credentials (REQUIRED)
POLYMARKET_API_KEY=your_api_key
POLYMARKET_API_SECRET=your_api_secret
POLYMARKET_API_PASSPHRASE=your_api_passphrase

# Telegram Notifications (RECOMMENDED)
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Trading Configuration
INITIAL_CAPITAL=1000
SIMULATE_MODE=false

# Polygon RPC (default: public, recommend private for production)
POLYGON_RPC=https://polygon-rpc.com

# Copy Trading Wallets (optional)
COPY_WALLET_RN1=
COPY_WALLET_DOMER=
COPY_WALLET_COLDMATH=

# Auto-Update Repository
GITHUB_REPO_URL=https://github.com/kevinleestites2-dev/Open-trade-.git
